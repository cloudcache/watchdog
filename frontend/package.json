		"@tailwindcss/vite": "^4.1.12",
		"@types/react": "^19.1.11",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react-swc": "^4.0.1",
		"tailwindcss": "^4.1.12",
