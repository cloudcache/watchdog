{
	"name": "watchdog",
	"private": true,
	"version": "0.18.7",
	"type": "module",
	"scripts": {
		"dev": "vite --host 127.0.0.1 --port 8090 --strictPort",
		"build": "lingui compile && vite build",
		"test": "node --experimental-strip-types --test src/lib/*.test.ts",
		"typecheck": "tsc --build --pretty false",
		"sync": "lingui extract --overwrite && lingui compile",
		"sync_no_compile": "lingui extract --overwrite --clean",
		"sync_and_purge": "lingui extract --overwrite --clean && lingui compile",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"check:fix": "biome check --fix ."
	},
	"dependencies": {
		"@lingui/core": "^5.4.1",
