		"@uppy/dashboard": "^6.0.0",
		"@uppy/react": "^6.0.0",
		"@uppy/tus": "^6.0.0",
		"@visactor/vchart": "^2.0.22",
		"@visactor/vtable": "^1.26.2",
		"@visactor/vtable-editors": "^1.26.2",
		"class-variance-authority": "^0.7.1",
