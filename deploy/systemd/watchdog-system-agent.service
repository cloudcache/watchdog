[Unit]
Description=Watchdog system agent
After=network-online.target watchdog-server.service
Wants=network-online.target

[Service]
Type=simple
User=watchdog
Group=watchdog
WorkingDirectory=/var/lib/watchdog
EnvironmentFile=-/etc/watchdog/agents/watchdog-system-agent.env
ExecStart=/opt/watchdog/current/bin/watchdog-system-agent $WATCHDOG_AGENT_ARGS
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/watchdog

[Install]
WantedBy=multi-user.target
